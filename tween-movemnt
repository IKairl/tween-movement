
--==================================================
-- TWEEN POSITION CONTROLLER v2
--==================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- CONFIGURATION
--==================================================

local CONFIG = {
	DefaultSpeed = 30,
	MinSpeed = 1,
	MaxSpeed = 500,

	Background = Color3.fromRGB(22, 24, 32),
	Panel = Color3.fromRGB(34, 37, 48),
	Accent = Color3.fromRGB(105, 125, 255),
	Text = Color3.fromRGB(240, 240, 245)
}

--==================================================
-- CLEANUP
--==================================================

local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local Existing = PlayerGui:FindFirstChild("TweenController")
if Existing then
	Existing:Destroy()
end

--==================================================
-- STATE
--==================================================

local ActiveTween = nil

--==================================================
-- CHARACTER HELPERS
--==================================================

local function GetCharacterRoot()
	local Character = LocalPlayer.Character

	if not Character then
		return nil
	end

	return Character:FindFirstChild("HumanoidRootPart")
end

local function ReadNumber(Box)
	if Box.Text == "" then
		return nil
	end

	return tonumber(Box.Text)
end

local function ReadVector(XBox, YBox, ZBox)
	local X = ReadNumber(XBox)
	local Y = ReadNumber(YBox)
	local Z = ReadNumber(ZBox)

	if X == nil or Y == nil or Z == nil then
		return nil
	end

	return Vector3.new(X, Y, Z)
end

--==================================================
-- STABILIZATION
--==================================================

local function StabilizeCharacter(ExpectedPosition)
	local Root = GetCharacterRoot()

	if not Root then
		return false
	end

	-- Preserve the current orientation.
	local CurrentCFrame = Root.CFrame

	-- Stop residual movement.
	Root.AssemblyLinearVelocity = Vector3.zero
	Root.AssemblyAngularVelocity = Vector3.zero

	-- Reapply the intended position when supplied.
	if ExpectedPosition then
		Root.CFrame = CFrame.new(ExpectedPosition)
			* (CurrentCFrame - CurrentCFrame.Position)
	else
		Root.CFrame = CurrentCFrame
	end

	return true
end

