--==================================================
-- HELPERS
--==================================================

local function GetRoot()
    local Character = Player.Character
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function ReadNumber(Box)
    if Box.Text == "" then
        return nil
    end

    local Number = tonumber(Box.Text)

    if not Number or Number ~= Number
        or Number == math.huge or Number == -math.huge then
        return nil
    end

    return Number
end

local function ReadVector(X, Y, Z)
    local A = ReadNumber(X)
    local B = ReadNumber(Y)
    local C = ReadNumber(Z)

    if A == nil or B == nil or C == nil then
        return nil
    end

    return Vector3.new(A, B, C)
end

--==================================================
-- CANCEL TWEEN
--==================================================

local function CancelTween()
    local Tween = ActiveTween

    if not Tween then
        return false
    end

    ActiveTween = nil
    TweenGeneration += 1

    local Root = GetRoot()
    local CurrentCFrame = Root and Root.CFrame

    Tween:Cancel()

    if Root and CurrentCFrame then
        Root.CFrame = CurrentCFrame
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end

    return true
end

--==================================================
-- START TWEEN
--==================================================

UI.StartButton.Activated:Connect(function()

    local Root = GetRoot()

    if not Root then
        UI.Status.Text = "Status: Character unavailable."
        return
    end

    local Target = ReadVector(
        UI.TargetX,
        UI.TargetY,
        UI.TargetZ
    )

    if not Target then
        UI.Status.Text = "Status: Enter valid target coordinates."
        return
    end

    local HasStart =
        UI.StartX.Text ~= ""
        or UI.StartY.Text ~= ""
        or UI.StartZ.Text ~= ""

    local StartPosition

    if HasStart then
        StartPosition = ReadVector(
            UI.StartX,
            UI.StartY,
            UI.StartZ
        )

        if not StartPosition then
            UI.Status.Text = "Status: Complete all start coordinates."
            return
        end
    else
        StartPosition = Root.Position
    end

    local Speed = ReadNumber(UI.SpeedBox)

    if not Speed or Speed < CONFIG.MinSpeed
        or Speed > CONFIG.MaxSpeed then
        UI.Status.Text = "Status: Speed must be 1–500."
        return
    end

    CancelTween()

    Root = GetRoot()

    if not Root then
        UI.Status.Text = "Status: Character unavailable."
        return
    end

    if HasStart then
        Root.CFrame = CFrame.new(StartPosition)
    else
        StartPosition = Root.Position
    end

    local Distance = (Target - StartPosition).Magnitude

    if Distance <= 0.001 then
        UI.Status.Text = "Status: Already at target."
        return
    end

    local Duration = Distance / Speed

    local Tween = TweenService:Create(
        Root,
        TweenInfo.new(
            Duration,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),
        {
            CFrame = CFrame.new(Target)
        }
    )

    TweenGeneration += 1
    local Generation = TweenGeneration

    ActiveTween = Tween

    UI.Status.Text = string.format(
        "Status: Moving | %.1f studs | %.2f seconds",
        Distance,
        Duration
    )

    Tween.Completed:Connect(function(PlaybackState)

        if ActiveTween ~= Tween
            or TweenGeneration ~= Generation then
            return
        end

        ActiveTween = nil

        if PlaybackState == Enum.PlaybackState.Completed then
            local CurrentRoot = GetRoot()

            if CurrentRoot then
                CurrentRoot.AssemblyLinearVelocity = Vector3.zero
                CurrentRoot.AssemblyAngularVelocity = Vector3.zero
            end

            UI.Status.Text = "Status: Target reached."
        end
    end)

    Tween:Play()
end)

