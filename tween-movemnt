--==================================================
-- MOVEMENT CONTROL
--==================================================

local function CancelActiveTween()
    local Tween = ActiveTween

    if not Tween then
        return false
    end

    -- Invalidate the completion callback.
    ActiveTween = nil
    TweenGeneration += 1

    -- Capture the current position.
    local Root = GetCharacterRoot()
    local CurrentCFrame = Root and Root.CFrame

    Tween:Cancel()

    if Root and CurrentCFrame then
        Root.CFrame = CurrentCFrame
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end

    return true
end

--==================================================
-- START TWEEN
--==================================================

StartButton.Activated:Connect(function()

    local Root = GetCharacterRoot()

    if not Root then
        Status.Text = "Status: Character unavailable."
        return
    end

    local TargetPosition = ReadVector(
        TargetX,
        TargetY,
        TargetZ
    )

    if not TargetPosition then
        Status.Text = "Status: Enter valid target coordinates."
        return
    end

    local HasStartInput =
        StartX.Text ~= ""
        or StartY.Text ~= ""
        or StartZ.Text ~= ""

    local StartingPosition

    if HasStartInput then
        StartingPosition = ReadVector(
            StartX,
            StartY,
            StartZ
        )

        if not StartingPosition then
            Status.Text = "Status: Complete all start coordinates."
            return
        end
    else
        StartingPosition = Root.Position
    end

    local Speed = ReadNumber(SpeedBox)

    if not Speed or Speed < CONFIG.MinSpeed
        or Speed > CONFIG.MaxSpeed then
        Status.Text = "Status: Speed must be 1–500."
        return
    end

    -- Stop any existing tween.
    CancelActiveTween()

    Root = GetCharacterRoot()

    if not Root then
        Status.Text = "Status: Character unavailable."
        return
    end

    -- Apply optional starting position.
    if HasStartInput then
        Root.CFrame = CFrame.new(StartingPosition)
    else
        StartingPosition = Root.Position
    end

    local Distance = (TargetPosition - StartingPosition).Magnitude

    if Distance <= 0.001 then
        Status.Text = "Status: Already at target."
        return
    end

    local Duration = Distance / Speed

    local TweenSettings = TweenInfo.new(
        Duration,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )

    local Tween = TweenService:Create(
        Root,
        TweenSettings,
        {
            CFrame = CFrame.new(TargetPosition)
        }
    )

    TweenGeneration += 1
    local ThisGeneration = TweenGeneration

    ActiveTween = Tween

    Status.Text = string.format(
        "Status: Moving | %.1f studs | %.2f seconds",
        Distance,
        Duration
    )

    Tween.Completed:Connect(function(PlaybackState)

        if ActiveTween ~= Tween
            or TweenGeneration ~= ThisGeneration then
            return
        end

        ActiveTween = nil

        if PlaybackState == Enum.PlaybackState.Completed then
            local CurrentRoot = GetCharacterRoot()

            if CurrentRoot then
                CurrentRoot.AssemblyLinearVelocity = Vector3.zero
                CurrentRoot.AssemblyAngularVelocity = Vector3.zero
            end

            Status.Text = "Status: Target reached."
        end

    end)

    Tween:Play()

end)

